# Public base URL (apex domain)
NEXT_PUBLIC_SITE_URL=https://koliinfotech.com

# API origin used in client-side fetches (if required)
NEXT_PUBLIC_API_BASE_URL=https://koliinfotech.com/api/

# Analytics and verification
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

# Contact and social metadata
NEXT_PUBLIC_CONTACT_EMAIL=info@koliinfotech.com
NEXT_PUBLIC_CONTACT_PHONE=+91 0000000000
NEXT_PUBLIC_FACEBOOK_URL=
NEXT_PUBLIC_TWITTER_URL=
NEXT_PUBLIC_INSTAGRAM_URL=
NEXT_PUBLIC_YOUTUBE_URL=
NEXT_PUBLIC_LINKEDIN_URL=

# SMTP credentials (server-only)
CONTACT_EMAIL_HOST=mail.koliinfotech.com
CONTACT_EMAIL_PORT=587
CONTACT_EMAIL_USER=contact@koliinfotech.com
CONTACT_EMAIL_PASSWORD=your-smtp-password
