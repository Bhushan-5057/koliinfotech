# Public site URL (used for sitemap / canonical / robots / Open Graph)
# Use your production HTTPS origin in deployed environments, e.g.:
# NEXT_PUBLIC_SITE_URL=https://koliinfotech.com
NEXT_PUBLIC_SITE_URL=https://koliinfotech.com

# Backend API base URL (must end with /api/)
NEXT_PUBLIC_API_BASE_URL=https://api.example.com/api/

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Search Console verification
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=your-google-site-verification-token

# Google Maps embed URL
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=YOUR_EMBED_PARAMS

# Contact form (Nodemailer cPanel webmail SMTP — keep secrets in .env / .env.local, never commit)
# Auth mailbox used as From for both emails:
CONTACT_EMAIL_HOST=mail.koliinfotech.com
CONTACT_EMAIL_PORT=587
CONTACT_EMAIL_USER=contact@koliinfotech.com
CONTACT_EMAIL_PASSWORD=your-smtp-password
# Owner inquiry recipients:
CONTACT_EMAIL_TO=ajay@koliinfotech.com
CONTACT_EMAIL_CC=contact@koliinfotech.com
CONTACT_EMAIL_TLS_SERVERNAME=mail.koliinfotech.com

# Contact / messaging
NEXT_PUBLIC_WHATSAPP_NUMBER=0000000000
NEXT_PUBLIC_WHATSAPP_FULL_NUMBER=910000000000
NEXT_PUBLIC_TEAMS_INVITE_URL=https://teams.live.com/l/invite/YOUR_INVITE_ID
NEXT_PUBLIC_CONTACT_EMAIL=info@example.com
NEXT_PUBLIC_CONTACT_PHONE=+91 0000000000

# Social links
NEXT_PUBLIC_FACEBOOK_URL=https://www.facebook.com/your-page/
NEXT_PUBLIC_TWITTER_URL=https://twitter.com/your-handle/
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/your-handle/
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@your-channel
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-company/

# Fallback avatar image (team photos)
NEXT_PUBLIC_FALLBACK_AVATAR_URL=https://example.com/fallback-avatar.jpg
